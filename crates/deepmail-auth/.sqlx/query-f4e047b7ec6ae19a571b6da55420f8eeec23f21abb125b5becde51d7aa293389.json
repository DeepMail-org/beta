  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, code_hash, expires_at, attempts, max_attempts\n        FROM otp_codes\n        WHERE user_id = $1\n          AND otp_type = $2\n          AND used = false\n          AND expires_at > now()\n        ORDER BY created_at DESC\n        LIMIT 1\n        ",
